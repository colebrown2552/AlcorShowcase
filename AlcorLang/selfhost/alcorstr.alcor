PROGRAM AlcorStrSelfTest WITH profile=complete authority=conformance
LET $bad 0
EMIT "alcorstr.alcor -- the string library the self-hosted interpreter stands on."
EMIT "Built from CHAR FIND LEN CAT only. AlcorLang has no comment syntax, so the WHY"
EMIT "lives in StrWhy below and prints here; the PASS lines under each are its proof."
EMIT ""

CALL StrWhy WITH $name="StrSlice" INTO $w
EMIT CAT "StrSlice -- " $w
CALL StrSlice WITH $s="hello world" $a=6 $b=11 INTO $g
CALL SelfCheck WITH $name="slice/basic" $got=$g $want="world" INTO $e; LET $bad ADD $bad $e
CALL StrSlice WITH $s="hello" $a=0 $b=0 INTO $g
CALL SelfCheck WITH $name="slice/index-0-empty" $got=$g $want="" INTO $e; LET $bad ADD $bad $e
CALL StrSlice WITH $s="hello" $a=0 $b=1 INTO $g
CALL SelfCheck WITH $name="slice/index-0-one" $got=$g $want="h" INTO $e; LET $bad ADD $bad $e
CALL StrSlice WITH $s="hello" $a=-4 $b=2 INTO $g
CALL SelfCheck WITH $name="slice/negative-start-clamps" $got=$g $want="he" INTO $e; LET $bad ADD $bad $e
CALL StrSlice WITH $s="hello" $a=3 $b=99 INTO $g
CALL SelfCheck WITH $name="slice/end-past-end-clamps" $got=$g $want="lo" INTO $e; LET $bad ADD $bad $e
CALL StrSlice WITH $s="hello" $a=99 $b=99 INTO $g
CALL SelfCheck WITH $name="slice/start-past-end" $got=$g $want="" INTO $e; LET $bad ADD $bad $e
CALL StrSlice WITH $s="hello" $a=4 $b=2 INTO $g
CALL SelfCheck WITH $name="slice/reversed-bounds" $got=$g $want="" INTO $e; LET $bad ADD $bad $e
CALL StrSlice WITH $s="" $a=0 $b=5 INTO $g
CALL SelfCheck WITH $name="slice/empty-haystack" $got=$g $want="" INTO $e; LET $bad ADD $bad $e
CALL StrSlice WITH $s="hello" $a=-9 $b=-3 INTO $g
CALL SelfCheck WITH $name="slice/both-negative" $got=$g $want="" INTO $e; LET $bad ADD $bad $e
EMIT ""

CALL StrWhy WITH $name="StrSubstr" INTO $w
EMIT CAT "StrSubstr -- " $w
CALL StrSubstr WITH $s="hello world" $a=6 $n=5 INTO $g
CALL SelfCheck WITH $name="substr/basic" $got=$g $want="world" INTO $e; LET $bad ADD $bad $e
CALL StrSubstr WITH $s="hello" $a=-3 $n=2 INTO $g
CALL SelfCheck WITH $name="substr/negative-start-still-gets-n" $got=$g $want="he" INTO $e; LET $bad ADD $bad $e
CALL StrSubstr WITH $s="hello" $a=3 $n=99 INTO $g
CALL SelfCheck WITH $name="substr/n-past-end" $got=$g $want="lo" INTO $e; LET $bad ADD $bad $e
CALL StrSubstr WITH $s="hello" $a=2 $n=0 INTO $g
CALL SelfCheck WITH $name="substr/zero-length" $got=$g $want="" INTO $e; LET $bad ADD $bad $e
CALL StrSubstr WITH $s="hello" $a=2 $n=-4 INTO $g
CALL SelfCheck WITH $name="substr/negative-length" $got=$g $want="" INTO $e; LET $bad ADD $bad $e
CALL StrSubstr WITH $s="" $a=0 $n=3 INTO $g
CALL SelfCheck WITH $name="substr/empty-haystack" $got=$g $want="" INTO $e; LET $bad ADD $bad $e
EMIT ""

CALL StrWhy WITH $name="StrStartsWith" INTO $w
EMIT CAT "StrStartsWith -- " $w
CALL StrStartsWith WITH $s="PROGRAM Main" $p="PROGRAM" $at=0 INTO $g
CALL SelfCheck WITH $name="startswith/at-0" $got=$g $want=1 INTO $e; LET $bad ADD $bad $e
