CALL SelfCheck WITH $name="pair/first-key" $got=$g $want="i42" INTO $e; LET $bad ADD $bad $e
CALL PairGet WITH $blob=$env $key="longer_name" INTO $g
CALL SelfCheck WITH $name="pair/second-key-empty-value" $got=$g $want="" INTO $e; LET $bad ADD $bad $e
CALL PairFind WITH $blob=$env $key="longer_name" INTO $g
CALL SelfCheck WITH $name="pair/offset-of-value-record" $got=$g $want=25 INTO $e; LET $bad ADD $bad $e
CALL PairFind WITH $blob=$env $key="nope" INTO $g
CALL SelfCheck WITH $name="pair/absent-key" $got=$g $want=-1 INTO $e; LET $bad ADD $bad $e
CALL PairFind WITH $blob="" $key="x" INTO $g
CALL SelfCheck WITH $name="pair/empty-env" $got=$g $want=-1 INTO $e; LET $bad ADD $bad $e
CALL PairFind WITH $blob=$env $key="i42" INTO $g
CALL SelfCheck WITH $name="pair/value-is-not-a-key" $got=$g $want=-1 INTO $e; LET $bad ADD $bad $e
EMIT ""

EMIT CAT "failures=" STR $bad
BRANCH EQ $bad 0 allpass
EMIT "ALCORSTR FAIL"
JUMP done
LABEL allpass
EMIT "ALCORSTR PASS"
LABEL done
END PROGRAM

PROGRAM SelfCheck
BRANCH EQ $got $want ok
EMIT CAT CAT "  FAIL " $name CAT "  got=[" CAT STR $got CAT "] want=[" CAT STR $want "]"
RETURN 1
LABEL ok
EMIT CAT "  pass " $name
RETURN 0
END PROGRAM

PROGRAM SelfRoundTrip
LET $blob ""
LET $k 0
LABEL enc
CALL SelfSample WITH $n=$k INTO $v
BRANCH EQ $v "<<STOP>>" encdone
CALL NsPut WITH $value=$v INTO $r
LET $blob CAT $blob $r
LET $k ADD $k 1
JUMP enc
LABEL encdone
LET $p 0
LET $j 0
LET $ok 0
LABEL dec
BRANCH GE $p LEN $blob decdone
CALL NsBody WITH $blob=$blob $pos=$p INTO $got
CALL SelfSample WITH $n=$j INTO $want
BRANCH NE $got $want miss
LET $ok ADD $ok 1
LABEL miss
CALL NsNext WITH $blob=$blob $pos=$p INTO $p
LET $j ADD $j 1
JUMP dec
LABEL decdone
RETURN CAT CAT STR $ok "/" STR $j
END PROGRAM

PROGRAM SelfSample
BRANCH EQ $n 0 s0
BRANCH EQ $n 1 s1
BRANCH EQ $n 2 s2
BRANCH EQ $n 3 s3
BRANCH EQ $n 4 s4
BRANCH EQ $n 5 s5
BRANCH EQ $n 6 s6
RETURN "<<STOP>>"
LABEL s0
RETURN "hi"
LABEL s1
RETURN ""
LABEL s2
RETURN "a,b:c,"
LABEL s3
RETURN "12:not-a-record,"
LABEL s4
RETURN "line1\nline2"
LABEL s5
RETURN "\"quoted\"\tand\ttabs"
LABEL s6
RETURN "3:xy,"
END PROGRAM

PROGRAM StrSlice
LET $n LEN $s
LET $i $a
BRANCH GE $i 0 lodone
LET $i 0
LABEL lodone
LET $j $b
BRANCH LE $j $n hidone
LET $j $n
LABEL hidone
LET $out ""
LABEL top
BRANCH GE $i $j stop
LET $out CAT $out CHAR $s $i
LET $i ADD $i 1
JUMP top
LABEL stop
RETURN $out
END PROGRAM

PROGRAM StrSubstr
LET $from $a
BRANCH GE $from 0 lodone
LET $from 0
LABEL lodone
CALL StrSlice WITH $s=$s $a=$from $b=ADD $from $n INTO $out
RETURN $out
END PROGRAM

PROGRAM StrStartsWith
LET $i $at
BRANCH GE $i 0 lodone
LET $i 0
LABEL lodone
CALL StrSlice WITH $s=$s $a=$i $b=ADD $i LEN $p INTO $got
RETURN INT EQ $got $p
END PROGRAM

PROGRAM StrEndsWith
LET $start SUB LEN $s LEN $p
BRANCH GE $start 0 fits
RETURN 0
LABEL fits
CALL StrSlice WITH $s=$s $a=$start $b=LEN $s INTO $got
RETURN INT EQ $got $p
END PROGRAM

PROGRAM StrIndexFrom
LET $n LEN $s
LET $i $from
BRANCH GE $i 0 lodone
LET $i 0
LABEL lodone
BRANCH LE $i $n hidone
LET $i $n
LABEL hidone
CALL StrSlice WITH $s=$s $a=$i $b=$n INTO $tail
LET $k FIND $tail $sub
BRANCH GE $k 0 hit
RETURN -1
LABEL hit
RETURN ADD $k $i
END PROGRAM

PROGRAM StrTrim
LET $n LEN $s
LET $lo 0
LABEL front
BRANCH GE $lo $n frontdone
CALL StrIsSpaceNl WITH $c=CHAR $s $lo INTO $w
BRANCH NOT $w frontdone
LET $lo ADD $lo 1
JUMP front
LABEL frontdone
LET $hi $n
LABEL back
BRANCH LE $hi $lo backdone
CALL StrIsSpaceNl WITH $c=CHAR $s SUB $hi 1 INTO $w
BRANCH NOT $w backdone
LET $hi SUB $hi 1
JUMP back
LABEL backdone
CALL StrSlice WITH $s=$s $a=$lo $b=$hi INTO $out
RETURN $out
END PROGRAM

PROGRAM StrRepeat
LET $out ""
LET $k 0
LABEL top
BRANCH GE $k $n stop
LET $out CAT $out $s
LET $k ADD $k 1
JUMP top
LABEL stop
RETURN $out
END PROGRAM

PROGRAM StrReplaceFirst
LET $k FIND $s $find
BRANCH GE $k 0 hit
RETURN $s
LABEL hit
CALL StrSlice WITH $s=$s $a=0 $b=$k INTO $head
CALL StrSlice WITH $s=$s $a=ADD $k LEN $find $b=LEN $s INTO $tail
RETURN CAT $head CAT $rep $tail
END PROGRAM

PROGRAM StrSplitNth
LET $w LEN $sep
BRANCH LT $n 0 none
BRANCH GT $w 0 seps
BRANCH EQ $n 0 whole
RETURN ""
LABEL whole
RETURN $s
LABEL seps
LET $pos 0
LET $k 0
LABEL skip
BRANCH GE $k $n skipdone
CALL StrIndexFrom WITH $s=$s $sub=$sep $from=$pos INTO $at
BRANCH LT $at 0 none
LET $pos ADD $at $w
LET $k ADD $k 1
JUMP skip
LABEL skipdone
CALL StrIndexFrom WITH $s=$s $sub=$sep $from=$pos INTO $end
BRANCH GE $end 0 cut
LET $end LEN $s
LABEL cut
CALL StrSlice WITH $s=$s $a=$pos $b=$end INTO $out
RETURN $out
LABEL none
RETURN ""
END PROGRAM

PROGRAM StrFieldCount
LET $w LEN $sep
BRANCH GT $w 0 seps
RETURN 1
LABEL seps
LET $fields 1
LET $pos 0
LABEL top
CALL StrIndexFrom WITH $s=$s $sub=$sep $from=$pos INTO $at
BRANCH LT $at 0 stop
LET $fields ADD $fields 1
LET $pos ADD $at $w
JUMP top
LABEL stop
RETURN $fields
END PROGRAM

PROGRAM StrIsDigit
RETURN INT AND GE $c "0" LE $c "9"
END PROGRAM

PROGRAM StrIsAlpha
BRANCH AND GE $c "a" LE $c "z" yes
BRANCH AND GE $c "A" LE $c "Z" yes
RETURN 0
LABEL yes
RETURN 1
END PROGRAM

PROGRAM StrIsSpace
BRANCH EQ $c " " yes
BRANCH EQ $c "\t" yes
BRANCH EQ $c "\r" yes
RETURN 0
LABEL yes
RETURN 1
END PROGRAM

PROGRAM StrIsSpaceNl
BRANCH EQ $c "\n" yes
CALL StrIsSpace WITH $c=$c INTO $r
RETURN $r
LABEL yes
RETURN 1
END PROGRAM

PROGRAM StrIsIdentChar
CALL StrIsAlpha WITH $c=$c INTO $r
BRANCH $r yes
CALL StrIsDigit WITH $c=$c INTO $r
BRANCH $r yes
BRANCH EQ $c "_" yes
RETURN 0
LABEL yes
RETURN 1
END PROGRAM

PROGRAM StrIsWordBreak
BRANCH EQ $c "" yes
BRANCH EQ $c " " yes
BRANCH EQ $c "\t" yes
BRANCH EQ $c "\r" yes
BRANCH EQ $c "\n" yes
BRANCH EQ $c ";" yes
BRANCH EQ $c "=" yes
BRANCH EQ $c "\"" yes
RETURN 0
LABEL yes
RETURN 1
END PROGRAM

PROGRAM StrIsInt
LET $n LEN $s
LET $i 0
BRANCH NE CHAR $s 0 "-" body
LET $i 1
LABEL body
BRANCH GE $i $n no
LABEL top
BRANCH GE $i $n yes
CALL StrIsDigit WITH $c=CHAR $s $i INTO $d
BRANCH NOT $d no
LET $i ADD $i 1
JUMP top
LABEL yes
RETURN 1
LABEL no
RETURN 0
END PROGRAM

PROGRAM NsPut
LET $t STR $value
RETURN CAT CAT STR LEN $t ":" CAT $t ","
END PROGRAM

PROGRAM NsColon
LET $i $pos
LET $cap ADD $pos 12
LABEL top
BRANCH EQ CHAR $blob $i ":" stop
BRANCH GE $i $cap stop
LET $i ADD $i 1
JUMP top
LABEL stop
RETURN $i
END PROGRAM

PROGRAM NsBody
CALL NsColon WITH $blob=$blob $pos=$pos INTO $c
CALL StrSlice WITH $s=$blob $a=$pos $b=$c INTO $d
LET $start ADD $c 1
CALL StrSlice WITH $s=$blob $a=$start $b=ADD $start INT $d INTO $body
RETURN $body
END PROGRAM

PROGRAM NsNext
CALL NsColon WITH $blob=$blob $pos=$pos INTO $c
CALL StrSlice WITH $s=$blob $a=$pos $b=$c INTO $d
RETURN ADD ADD $c 1 ADD INT $d 1
END PROGRAM

PROGRAM NsNth
LET $p 0
LET $k 0
BRANCH LT $n 0 oob
LABEL top
BRANCH GE $k $n stop
BRANCH GE $p LEN $blob oob
CALL NsNext WITH $blob=$blob $pos=$p INTO $p
LET $k ADD $k 1
JUMP top
LABEL stop
BRANCH GE $p LEN $blob oob
CALL NsBody WITH $blob=$blob $pos=$p INTO $body
RETURN $body
LABEL oob
RETURN ""
END PROGRAM

PROGRAM NsCount
LET $p 0
LET $k 0
LABEL top
BRANCH GE $p LEN $blob stop
CALL NsNext WITH $blob=$blob $pos=$p INTO $p
LET $k ADD $k 1
JUMP top
LABEL stop
RETURN $k
END PROGRAM

PROGRAM PairFind
LET $p 0
LABEL top
BRANCH GE $p LEN $blob miss
CALL NsBody WITH $blob=$blob $pos=$p INTO $k
CALL NsNext WITH $blob=$blob $pos=$p INTO $v
BRANCH EQ $k $key hit
BRANCH GE $v LEN $blob miss
CALL NsNext WITH $blob=$blob $pos=$v INTO $p
JUMP top
LABEL hit
RETURN $v
LABEL miss
RETURN -1
END PROGRAM

PROGRAM PairGet
CALL PairFind WITH $blob=$blob $key=$key INTO $at
BRANCH GE $at 0 hit
RETURN ""
LABEL hit
CALL NsBody WITH $blob=$blob $pos=$at INTO $v
RETURN $v
END PROGRAM

PROGRAM StrCatalog
RETURN "StrSlice,StrSubstr,StrStartsWith,StrEndsWith,StrIndexFrom,StrTrim,StrRepeat,StrReplaceFirst,StrSplitNth,StrFieldCount,StrIsDigit,StrIsAlpha,StrIsSpace,StrIsSpaceNl,StrIsIdentChar,StrIsWordBreak,StrIsInt,NsPut,NsColon,NsBody,NsNext,NsNth,NsCount,PairFind,PairGet,StrCatalog,StrWhy"
END PROGRAM

PROGRAM StrWhy
BRANCH EQ $name "StrSlice" slice
BRANCH EQ $name "StrSubstr" substr
BRANCH EQ $name "StrStartsWith" starts
BRANCH EQ $name "StrIndexFrom" indexfrom
BRANCH EQ $name "StrTrim" trim
BRANCH EQ $name "StrRepeat" repeat
BRANCH EQ $name "StrReplaceFirst" replace
BRANCH EQ $name "StrSplitNth" split
BRANCH EQ $name "StrIsSpace" isspace
BRANCH EQ $name "StrIsWordBreak" wordbreak
BRANCH EQ $name "StrIsIdentChar" identchar
BRANCH EQ $name "StrIsInt" isint
BRANCH EQ $name "NsPut" nsput
BRANCH EQ $name "NsColon" nscolon
BRANCH EQ $name "NsNext" nsnext
BRANCH EQ $name "NsNth" nsnth
BRANCH EQ $name "PairFind" pairfind
RETURN "no reason recorded. if this routine has a non-obvious shape, record it here."
LABEL slice
RETURN "clamps both ends instead of trapping. the only reason to slice inside a lexer is to ask what is there, and asking has to be safe past both ends -- the same argument that made CHAR total."
LABEL substr
RETURN "clamps the start BEFORE counting, so n characters means n characters. slicing to start+n first would silently hand back a short string whenever the start was negative."
LABEL starts
RETURN "returns int 1 or 0, never a bool. every predicate in this file does, so a caller may add them up, CAT STR them, or BRANCH on them without knowing which kind it got."
LABEL indexfrom
RETURN "exists only because native FIND has no start offset. it copies the tail to search it, so scanning a long blob with it is quadratic -- the Ns* walkers step by length prefix instead, and never call this."
LABEL trim
RETURN "asks StrIsSpaceNl, not StrIsSpace. trimming a line means the newline too; a lexer must never skip one. the two predicates exist so that difference is stated once, here."
LABEL repeat
RETURN "treats every n below 1 as zero rather than trapping, because the callers that want padding compute n by subtraction and a short string makes n negative."
LABEL replace
RETURN "replaces the leftmost match only, and an empty needle matches at 0, so it prepends. that is what Python does, and the differential harness compares against Python."
LABEL split
RETURN "returns the empty string both for an empty field and for a field past the last one. it cannot tell you which; StrFieldCount is how you ask."
LABEL isspace
RETURN "is the reference lexer skip set, space tab CR, exactly. newline is excluded on purpose: in AlcorLang a newline is a statement separator, so a lexer that skipped one would erase statement boundaries."
LABEL wordbreak
RETURN "answers yes for the empty string as well as for the six break characters. running off the end ends a word, so a scanner written against this predicate alone cannot spin forever."
LABEL identchar
RETURN "is ASCII only, while the reference scans a cell name with Python isalnum, which is Unicode-wide. both reject a non-ASCII cell name -- through different messages. that divergence is known and written down, not fixed."
LABEL isint
RETURN "exists because INT traps bad_int. a lexer has to ASK whether a word is a number before converting it, and there is no other way to ask without falling over."
LABEL nsput
RETURN "is the plain netstring encoding: decimal length, colon, bytes, comma. the tests decode a hand-written blob in exactly that form to prove it."
LABEL nscolon
RETURN "scans at most twelve characters, because a length prefix is decimal digits and nothing here is longer. a corrupt blob then shows up as a bad_int trap at the INT, which is loud, instead of as a scan of the whole tape."
LABEL nsnext
RETURN "never reads the payload, only the length prefix. that is what lets a program counter be a byte offset into a blob instead of a record index -- fetch stays O(1) where an index would rescan."
LABEL nsnth
RETURN "returns the empty string for an index past the end, which is also a perfectly legal payload. NsCount is how you tell those apart."
LABEL pairfind
RETURN "returns the byte offset of the VALUE record, not the value. the environment rewrites a binding in place by splicing around that offset, so it needs the position, not a copy."
END PROGRAM
