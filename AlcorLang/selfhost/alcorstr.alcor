CALL SelfCheck WITH $name="startswith/needle-longer" $got=$g $want=0 INTO $e; LET $bad ADD $bad $e
CALL StrStartsWith WITH $s="abc" $p="" $at=1 INTO $g
CALL SelfCheck WITH $name="startswith/empty-prefix" $got=$g $want=1 INTO $e; LET $bad ADD $bad $e
